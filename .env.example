# Optional Server Environment Variables
# Note: SkyPilot uses a Bring-Your-Own-Key (BYOK) & On-Device WebAI architecture.
# End-users configure their own API keys or local WebAI models in the browser Settings UI.

# Server port (defaults to 3001)
PORT=3001

# Optional default server-side Gemini API key (only used if a client request omits x-ai-api-key)
GEMINI_API_KEY=

# Optional Frontend Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
